# Copy to config.env (never committed) and fill in.
# ntfy topics: pick long random names - anyone who knows a topic name can read it.
NTFY_ALERTS_TOPIC=ps5tracker_alerts_CHANGE_ME_x7k2
NTFY_PROBLEMS_TOPIC=ps5tracker_problems_CHANGE_ME_x7k2
DASHBOARD_URL=https://YOUR_GITHUB_USER.github.io/ps5_games_tracker/

# AI agent (Claude Code, your subscription). Sonnet is enough nightly; use opus for big one-off jobs.
CLAUDE_MODEL=sonnet
CLAUDE_MAX_TURNS=60
CLAUDE_MAX_TURNS_SUNDAY=120
